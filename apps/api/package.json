{
  "name": "@aagb/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsx build.ts",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "tsx scripts/local-only.ts \"prisma migrate dev\"",
    "db:seed": "tsx scripts/local-only.ts \"tsx prisma/seed.ts\"",
    "db:reset": "tsx scripts/local-only.ts \"prisma migrate reset --force --skip-seed\" \"tsx prisma/seed.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@aagb/shared": "^0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "embedded-postgres": "17.11.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
