# Copie para .env e preencha. O .env nunca vai para o Git.
# A API valida tudo isto ao iniciar e não sobe se algo estiver errado.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# Banco Postgres. As tabelas ficam no esquema "aagb" (schema=aagb), nunca no "public".
#
# Desenvolvimento: Postgres local sem instalar nada. Rode `npm run db:local -w apps/api` e deixe aberto.
# Porta e senha abaixo precisam bater com LOCAL_PG_PORT e LOCAL_PG_PASSWORD (padrão 5433 e aagb-local).
DATABASE_URL=postgresql://postgres:aagb-local@127.0.0.1:5433/aagb?schema=aagb
DIRECT_URL=postgresql://postgres:aagb-local@127.0.0.1:5433/aagb?schema=aagb
# LOCAL_PG_PORT=5433
# LOCAL_PG_PASSWORD=aagb-local
#
# Produção no Supabase (veja docs/supabase.md). Em Project Settings > Database > Connection string:
#   DATABASE_URL: "Transaction pooler" (porta 6543), com ?pgbouncer=true&schema=aagb&sslmode=require
#   DIRECT_URL:   "Session pooler" (porta 5432), com ?schema=aagb&sslmode=require (usada só nas migrações)
# Exemplo (troque PROJETO, SENHA e a região):
#   DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=aagb&sslmode=require
#   DIRECT_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=aagb&sslmode=require
# A API não sobe em produção sem schema próprio e sem sslmode=require.

# Segredo dos tokens de acesso. Pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Endereços do site que podem chamar a API, separados por vírgula. Nunca "*".
CORS_ORIGINS=http://localhost:5173

# Cookies só por HTTPS. Pode ser false APENAS em desenvolvimento local (http://localhost).
COOKIE_SECURE=false

# Número de proxies reversos à frente da API (Nginx, Render, Railway…: normalmente 1),
# para o limite por IP usar o IP real do visitante. false quando não há proxy.
TRUST_PROXY=false

# Pasta dos PDFs da Transparência. Precisa persistir entre deploys (volume/disco).
UPLOAD_DIR=./uploads

# LGPD: dias até apagar nome, telefone, e-mail e endereço de pedidos, solicitações e doações.
PERSONAL_DATA_RETENTION_DAYS=365

# Limites por IP, por minuto.
FORM_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Custo do bcrypt. Mínimo 12 fora dos testes.
BCRYPT_COST=12

# SÓ PARA DESENVOLVIMENTO: com os dois preenchidos, `npm run db:seed` cria uma conta de
# administrador para testar o painel. Ignorado em produção (use `npm run user:create`).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
