# Copie para .env.local e preencha. Variáveis VITE_* ficam visíveis no navegador: nunca coloque segredos aqui.

# Número do WhatsApp da associação, com DDI e DDD, só dígitos (ex.: 5588999990000).
# Sem ele, o botão "Enviar pelo WhatsApp" do carrinho não aparece.
VITE_WHATSAPP_NUMBER=

# Endereço da API (apps/api), sem barra no fim. Em desenvolvimento: http://localhost:3333
# Sem ele, o site usa os dados de exemplo em memória.
VITE_API_URL=
